---
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import food from "../../../src/data/food.json";

const rows = food.map((f) => ({
  name: f.name,
  href: `/food/${f.slug}/`,
  kind: f.cooked ? "Cooked" : "Raw/Other",
  rarity: f.rarity,
  hunger: f.hunger,
  buffs: Object.keys(f.buffs).slice(0, 2).join(", ") || "—",
  area: f.area || "—",
}));
// /food/group/<group>/ aggregate pages come from this same dataset; without a
// link here they are declared in the sitemap but never reachable by crawl.
// there is no group field; the aggregate pages derive cooked/raw from `cooked`
const groups = [...new Set(food.map((f) => (f.cooked ? "cooked" : "raw")))].sort();
---

<Base
  title="All Core Keeper Food — Ranked by Hunger Restored"
  description="Every food and consumable in Core Keeper ranked by hunger restored, with buffs and recipes. Sortable and searchable."
>
  <h1>Food & Consumables</h1>
  <p class="muted">
    {food.length} items, ranked from most hunger restored. Cooked dishes usually beat raw
    ingredients — the ranking makes it obvious which recipes are worth cooking. Click a name
    for buffs and recipe.
  </p>
  <DataTable
    id="food"
    rows={rows}
    searchPlaceholder="Search food..."
    columns={[
      { key: "name", label: "Food", href: "href" },
      { key: "kind", label: "Kind" },
      { key: "rarity", label: "Rarity" },
      { key: "hunger", label: "Hunger", type: "number" },
      { key: "buffs", label: "Buffs" },
      { key: "area", label: "Biome" },
    ]}
  />

  <h2>Browse by group</h2>
  <p class="muted">
    Food split into raw ingredients and cooked dishes — open a group for the full list.
  </p>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:0.35rem 0.9rem;margin:1rem 0 2rem">
    {groups.map((g) => (
      <a href={`/food/group/${g}/`} style="font-size:0.9rem">{g}</a>
    ))}
  </div>
</Base>
